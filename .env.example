# ──────────────────────────────────────────────────────────────────────────────
# NOLA Lead Intelligence Dashboard — environment template
# Copy to .env.local and fill in real values. .env.local is gitignored.
# ──────────────────────────────────────────────────────────────────────────────

# Supabase ─ Project Settings → API
# The URL is safe to expose to the browser; the service-role key is NOT.
# The service-role key is only ever read server-side (API routes + scripts).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Google Maps Platform — use TWO separate keys:
#   1. GOOGLE_MAPS_API_KEY        (server) Places API (New) + Geocoding API.
#      Restrict by API in the Cloud console; never shipped to the browser.
#   2. NEXT_PUBLIC_GOOGLE_MAPS_BROWSER_KEY (browser) Maps JavaScript API only.
#      Restrict by HTTP referrer (your domains) in the Cloud console.
GOOGLE_MAPS_API_KEY=your-server-side-places-key
NEXT_PUBLIC_GOOGLE_MAPS_BROWSER_KEY=your-browser-maps-js-key

# Apollo.io — Settings → Integrations → API
APOLLO_API_KEY=your-apollo-api-key

# Anthropic — used ONLY for qualitative outputs (prospect summary + outreach
# copy, Phase 3). All numeric scoring is deterministic and never calls an LLM.
ANTHROPIC_API_KEY=your-anthropic-api-key
# Optional override. Defaults to claude-opus-4-8.
ANTHROPIC_MODEL=claude-opus-4-8
